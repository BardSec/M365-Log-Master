# Azure AD App Registration credentials
TENANT_ID=your-tenant-id-here
CLIENT_ID=your-client-id-here
CLIENT_SECRET=your-client-secret-here
GRAPH_SCOPE=https://graph.microsoft.com/.default

# PostgreSQL (used by docker-compose; adjust for external DB)
DATABASE_URL=postgresql://m365user:m365pass@db:5432/m365logs

# Flask
FLASK_ENV=production
SECRET_KEY=change-me-to-a-random-secret
PORT=8080

# Microsoft SSO – set OAUTH_ENABLED=true to require login via Microsoft
# OAUTH_REDIRECT_URI must match a Web redirect URI in your Azure AD app registration
# Example: https://your-domain.com/auth/callback
OAUTH_ENABLED=false
OAUTH_REDIRECT_URI=http://localhost:8080/auth/callback

# Optional basic auth (alternative to OAuth; leave blank to disable)
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=

# Sync settings
SYNC_INTERVAL_MINUTES=60
SYNC_LOOKBACK_MINUTES=5

# Cloudflare R2 archive (offload sign-in events older than ARCHIVE_HOT_DAYS)
# Leave R2_BUCKET blank to disable archiving entirely.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Archive retention
ARCHIVE_ENABLED=false
ARCHIVE_HOT_DAYS=35
